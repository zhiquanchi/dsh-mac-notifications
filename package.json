{
  "name": "dsh-mac-notifications",
  "version": "1.0.0",
  "private": false,
  "description": "Native macOS Notification Center alerts for DeepSeek Harness: agent questions, task completion, and task failures",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "notification",
    "notifications",
    "macos",
    "osascript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhiquanchi/dsh-mac-notifications.git"
  },
  "homepage": "https://github.com/zhiquanchi/dsh-mac-notifications#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
